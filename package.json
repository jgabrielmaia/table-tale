{
  "name": "table-tale",
  "private": true,
  "version": "0.7.0-alpha",
  "type": "module",
  "description": "Table Tale — biblioteca viva de jogos de tabuleiro (React + Supabase).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:e2e": "tsc -p tests/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:report": "playwright show-report",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "seed:communities": "tsx scripts/seed-communities.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
