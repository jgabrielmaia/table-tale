# ---------------------------------------------------------------
# Frontend (Vite). Valores PÚBLICOS: ficam no bundle do browser.
# A anon key é pública por design — a segurança vem do RLS.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# URL pública da app (sem barra final). Produção: https://jgabrielmaia.com/table-tale
VITE_SITE_URL=http://localhost:5173/table-tale

# ---------------------------------------------------------------
# Scripts de servidor (seed). NUNCA usar prefixo VITE_ nem publicar.
# ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Conta que é dona inicial de todos os jogos (Gabriel Maia).
OWNER_EMAIL=owner@example.com

# ---------------------------------------------------------------
# OAuth (Google, GitHub): configurado no painel Supabase
# (Authentication > Providers), não no frontend. Ver docs/auth-setup.md.
# Só necessário aqui se usar o Supabase CLI localmente (supabase/config.toml).
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
