# ---------------------------------------------------------------
# Frontend (Vite). Valores PÚBLICOS: ficam no bundle do browser.
# A anon key é pública por design — a segurança vem do RLS.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# URL pública da app (sem barra final). Produção: https://jgabrielmaia.com/table-tale
VITE_SITE_URL=http://localhost:5173/table-tale
# URL canónica usada no sitemap, canonicals e JSON-LD gerados no build (por omissão: https://jgabrielmaia.com/table-tale).
# SITE_URL=https://jgabrielmaia.com/table-tale

# Feature flags (build time: mudar exige novo build/deploy). "true" liga; vazio ou outro valor desliga.
# BGG: pesquisa e importação do BoardGameGeek. Desligado até o BGG aprovar o token da API.
VITE_FEATURE_BGG=false

# ---------------------------------------------------------------
# Local auth bypass (só `npm run dev` em localhost; ignorado em builds de produção).
# Inicia sessão automaticamente com uma conta de DEV já criada no Supabase (email+password),
# sem redirecionar para OAuth. Use apenas um projeto/conta de desenvolvimento.
# ---------------------------------------------------------------
VITE_LOCAL_AUTH_BYPASS=false
VITE_LOCAL_AUTH_BYPASS_EMAIL=dev@example.com
VITE_LOCAL_AUTH_BYPASS_PASSWORD=

# ---------------------------------------------------------------
# Scripts de servidor (seed). NUNCA usar prefixo VITE_ nem publicar.
# ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Conta que é dona inicial de todos os jogos (Gabriel Maia).
OWNER_EMAIL=owner@example.com

# ---------------------------------------------------------------
# OAuth (Google, GitHub): configurado no painel Supabase
# (Authentication > Providers), não no frontend. Ver docs/auth-setup.md.
# Só necessário aqui se usar o Supabase CLI localmente (supabase/config.toml).
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
